{
  "manifest_version": 3,
  "name": "Chat GPT Quickly",
  "version": "1.0.0",
  "description": "Mo khung chat AI nhanh tren moi trang web.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["chat-widget.css", "extension_icon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["chat-widget.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chat GPT Quickly",
    "default_icon": {
      "128": "extension_icon.png"
    }
  },
  "icons": {
    "128": "extension_icon.png"
  }
}